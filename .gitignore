# Packer build output.
# The REAL location is <repo>/output — output_directory is resolved against the working
# directory, and packer runs from the repository root — so both are listed.
/output/
output.prev.*
build_archlinux/output/
build_archlinux/output.prev.*
*.qcow2
*.qcow2.sha512
*.qcow2.sha512.txt

# Packer plugin cache
.packer.d/
packer_cache/
*.pkr.hcl.lock.hcl

# The reinstall payload. Per-server and secret-bearing: it carries the LUKS passphrase
# for that machine in configDriveUserData, plus the SSH key. It must never be committed,
# and it was not ignored until it had already acquired a passphrase -- one `git add -A`
# from publishing the only key to the encrypted volume.
deploy.json
deploy.json~

# OVHcloud API credentials for scripts/ovh-reinstall.exs. The application secret is shown
# once at token creation and grants reinstall rights on the server -- which erases it.
deploy.env

# Local notes / scratch
*.log
.DS_Store

# Erlang VM crash dumps. The VM crashed while this project's Elixir scripts were being
# developed, and `git add -A` published 4.9 MB of them to a public repo twice.
erl_crash.dump
deploy.env~

# Emacs autosave and lock files; #deploy.json# would carry the passphrase and SSH key
\#*\#
.#*

# LUKS header backups downloaded from the server. A header plus the passphrase decrypts
# the whole disk; they must never be committed, and they do not belong in a repo at all.
luks-header-*.img
*.luks-header
