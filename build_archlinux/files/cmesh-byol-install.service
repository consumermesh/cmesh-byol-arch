[Unit]
Description=cmesh BYOL first-boot encrypted install (LUKS2 under RAID1)
Documentation=https://github.com/consumermesh/cmesh-byol-arch
# ORDERING: deliberately minimal, and do not add to it casually.
#
# TWO separate defects have lived in these four lines, both of the same kind -- a
# defensive ordering dependency that stopped the installer from ever running, silently,
# with no output anywhere.
#
# 1. The unit carried `DefaultDependencies=no`, `After=sysinit.target local-fs.target`
#    AND `Before=network-pre.target` while also being `WantedBy=multi-user.target`.
#    network-pre.target is ordered before multi-user.target, so the unit was required to
#    run before a target that runs before the unit itself. Systemd resolves a cycle like
#    that by dropping the job -- no output, no error, nothing on the console.
#
# 2. It then carried `After=cloud-init.target`, on the reasoning that cloud-init mounts
#    the config drive and the config drive holds the LUKS passphrase. THAT REASONING WAS
#    WRONG: cmesh-byol-install mounts the config drive itself, by label
#    (blkid -t LABEL=cidata / LABEL=config-2), and never touches cloud-init. On the
#    deployment that exposed this, cloud-init stalled with its final stage never
#    finishing ("modules-final": {"finished": null}), so cloud-init.target was never
#    reached, so this unit waited forever and the installer never ran.
#
# The lesson is the one this project keeps relearning: a dependency added to make
# something safer becomes the single point of failure, and a job that never starts
# reports nothing. Order only after things that are STRUCTURALLY always reached.
#
# local-fs.target is the only real prerequisite -- the config drive is a partition, and
# by multi-user.target the kernel has already mounted it -- and multi-user.target is
# itself ordered after it. So this is documentation as much as ordering.
#
# If you ever need this to run earlier, remove it from multi-user.target.wants and wire
# it explicitly -- but do NOT re-add Before=network-pre.target, and do NOT add any
# ordering against cloud-init.
After=local-fs.target
# Never let a failed install be "restarted" into a loop that re-wipes disks. The script
# exits 0 when the completion marker exists; a genuine failure stops here and is read
# over the serial console, which the script tees to.
ConditionPathExists=!/var/lib/cmesh-byol/installed

[Service]
Type=oneshot
RemainAfterExit=yes
# Serial console output for KVM diagnosis, plus the journal.
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=3600
# The install legitimately reboots and destroys filesystems; do not let systemd's
# sandboxing get in the way of block-device access.
PrivateDevices=no
ProtectSystem=no
ProtectHome=no
ExecStart=/usr/local/sbin/cmesh-byol-install

[Install]
WantedBy=multi-user.target
