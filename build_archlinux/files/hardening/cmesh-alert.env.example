# Per-host config for cmesh-alert's off-box delivery.
#
# cmesh-byol-harden installs this as /etc/cmesh-byol/alert.env.example and copies it
# to /etc/cmesh-byol/alert.env ONLY if that file does not exist yet, so a re-run never
# clobbers a host that has been configured.
#
#   sudo cp /etc/cmesh-byol/alert.env.example /etc/cmesh-byol/alert.env
#   sudoedit /etc/cmesh-byol/alert.env
#   sudo chmod 0600 /etc/cmesh-byol/alert.env
#   sudo /usr/local/sbin/cmesh-alert test "delivery check"
#   sudo journalctl -t cmesh-alert -n 5
#   scripts/cmesh-alert-poller          # on a machine that is NOT this one
#
# It is read by cmesh-alert as root, so it must stay root-owned and 0600, and it must
# hold nothing but CMESH_ALERT_* settings. It governs DELIVERY ONLY: detection is
# cmesh-logwatch (five-minute timer), and mdadm, smartd, the arch-audit timer and the
# integrity timer report through the same funnel.
#
# WHAT LEAVES THE HOST
#
# One age-encrypted JSON object per alert: {"ts","host","source","message"}. It is
# PHI-FREE BY CONSTRUCTION -- no caller passes journal text, because httpd logs the
# request URI and a Phoenix/OTP crash report embeds tenant slugs, record ids and
# changeset values. Callers send a summary instead (unit, count, class, timestamp) and
# the operator reads the detail on the host. If you add a caller, keep it that way.

# off (default: the alert stays in the journal and /var/log/cmesh-alerts.log)
# s3  (upload to the bucket below)
CMESH_ALERT_DELIVERY=off

# --- delivery=s3: where the object goes --------------------------------------
# The same Linode Object Storage account the encrypted backups use: no new vendor,
# no new key, no listening port. Set a dedicated prefix so alerts are not mixed in
# with the backups.
#CMESH_ALERT_S3_ENDPOINT=us-east-1.linodeobjects.com
#CMESH_ALERT_S3_BUCKET=cmeshai-backups
#CMESH_ALERT_S3_PREFIX=alerts

# --- delivery=s3: the credentials --------------------------------------------
# cmesh-alert runs from smartd, mdadm, cron and systemd timers, so it cannot rely on
# the backup unit's environment being present. Point this at the file that already
# holds the keys for the same bucket; only AWS_* assignments are read from it, and it
# is parsed, never sourced.
#CMESH_ALERT_CREDENTIALS_FILE=/etc/marshall/backup.env

# --- delivery=s3: who can read it --------------------------------------------
# age PUBLIC recipients, one per line. Generate the keypair OFFLINE and keep the
# PRIVATE identity off this host -- that is the point: the provider stores ciphertext,
# and so does anyone who reads the bucket later.
#   age-keygen -o ~/marshall-alert-identity.txt     # offline; keep this file safe
#   grep '^# public key:' ~/marshall-alert-identity.txt | cut -d: -f2- > recipients
# See deploy/runbooks/encrypted_backups.md for the same workflow used by backups.
#CMESH_ALERT_AGE_RECIPIENTS=/etc/cmesh-byol/alert-recipients.txt

# Seconds before a delivery attempt is abandoned. The alert stays local either way;
# this only bounds how long a caller waits for a sick network.
#CMESH_ALERT_TIMEOUT=30
