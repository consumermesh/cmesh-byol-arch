#!/bin/bash
# cmesh-byol-install — first-boot encrypted install for OVHcloud bare metal.
#
# Runs ONCE, from the freshly-deployed BYOL image, and turns the layout OVHcloud built
# into this:
#
#   nvme0n1                                  nvme1n1
#   ├─p1  ESP  vfat  /boot/efi               ├─p1  ESP  vfat   (loader mirrored by the hook)
#   ├─p2  ─┐ md (raid1, ext4) → /boot        ├─p2  ─┘          [unencrypted, GRUB reads it]
#   ├─p3  ─┐ md (raid1, ext4) → bootstrap /  ├─p3  ─┘          [dormant after the install]
#   └─p4  LUKS2 ─┐                           └─p4  LUKS2 ─┐
#        cryptroot0 ─┴─ md/cmeshroot (raid1, ext4) → /  ─┴─ cryptroot1   [encrypted]
#
# OVHcloud's partitioner creates every partition above. It is asked (deploy.json) for
# /boot, a small / for this bootstrap system, and a large third RAID1 partition mounted
# at /data. THAT PARTITION IS THE PAYLOAD: nothing runs from it, so it is the one thing
# on these disks that can be destroyed and rebuilt while the machine is up.
#
# WHY NOT REPARTITION THE DISKS
#
# The previous design wiped both disks and re-created every partition from a running
# system whose root was on those very disks. Linux does not allow that: the kernel will
# not reload a partition table while any partition is held open, and the bootstrap's
# md arrays hold them. wipefs/sgdisk fail with EBUSY, or write a GPT the kernel ignores,
# and every later step then operates on the OLD partitions — which are busy. Staging the
# rootfs in tmpfs changes nothing, because nothing ever pivoted off the old root.
#
# Taking the layout from the deployer instead means: the partition table is never
# touched; /boot and the ESPs are shared with the bootstrap and already carry a working
# GRUB (installed by the deploy hook, which is the only place OVHcloud lets one be
# installed); and the bootstrap root stays intact as a rescue environment until the
# first encrypted boot has been verified.
#
# LUKS sits UNDER the RAID, one header per disk, so a disk failure costs a disk rather
# than the array. See README for why that ordering is not negotiable.
#
# THIS DESTROYS THE PAYLOAD PARTITION. The bootstrap root, /boot and the ESPs survive.
#
# Every precondition is checked before anything destructive happens, and the completion
# marker is written only at the very end, so a failure is re-runnable and diagnosable
# over KVM.

set -euo pipefail

readonly MARKER=/var/lib/cmesh-byol/installed
readonly WORKDIR=/run/cmesh-byol
readonly MNT=/mnt/cmesh-target
readonly LOG=/var/log/cmesh-byol-install.log
# Where deploy.json asks OVHcloud to mount the payload partition. Everything below finds
# the partition through this mount, never by a hardcoded device name.
readonly DATA_MOUNT=/data
# The encrypted root array. Named rather than numbered: md NUMBERS are not stable, and
# the bootstrap's own arrays already occupy the low ones.
readonly ROOT_MD_NAME=cmeshroot
readonly ROOT_MD=/dev/md/cmeshroot
readonly LUKS_KEY=/boot/cmesh-luks.key
# How long to wait for the config-drive partition to be enumerated before giving up and
# reporting. Not a dependency on anything -- see wait_for_config_drive().
readonly CONFIG_DRIVE_TIMEOUT_SEC=60

# Duplicated to the serial console so a failed install is readable over KVM, where
# journald may never flush.
exec > >(tee -a "$LOG" /dev/console) 2>&1

log()  { printf '\n=== %s\n' "$*"; }
warn() { printf '\n!!! %s\n' "$*" >&2; }
die()  { printf '\nFATAL: %s\n' "$*" >&2; exit 1; }

### Preconditions ###################################################################

check_already_done() {
    if [ -f "$MARKER" ]; then
        log "already installed ($MARKER present) — disabling and exiting"
        systemctl disable cmesh-byol-install.service || true
        exit 0
    fi
}

check_arch() {
    [ -f /etc/arch-release ] || die "not an Arch system (/etc/arch-release missing)"
    findmnt -no FSTYPE /run | grep -q tmpfs \
        || die "/run is not tmpfs; there is nowhere safe to hold the temporary LUKS key"
}

check_tools() {
    local t
    for t in cryptsetup mdadm wipefs mkfs.ext4 rsync blkid findmnt lsblk \
             grub-mkconfig mkinitcpio lsinitcpio mkswap fallocate; do
        command -v "$t" >/dev/null 2>&1 || die "required tool missing: $t"
    done
}

check_layout() {
    # The deployer must have produced the layout deploy.json asks for. Each of these is
    # checked by what is MOUNTED, because that is what the deployer actually did; the
    # partition table is only consulted to confirm the members.
    #
    # Sets: PAYLOAD_MD, MEMBERS[] (one partition per disk), DISKS[].
    log "checking the layout OVHcloud built"
    lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINT | sed 's/^/    /'

    # /boot must be its own filesystem: the installed system shares it with the
    # bootstrap, and the kernel, initramfs and grub.cfg all live there.
    mountpoint -q /boot \
        || die "/boot is not a separate filesystem; deploy.json must request a /boot partition"
    mountpoint -q /boot/efi \
        || die "/boot/efi is not mounted; the deployer did not mount the ESP"

    # The payload.
    PAYLOAD_MD=$(findmnt -no SOURCE "$DATA_MOUNT" 2>/dev/null || true)
    [ -n "$PAYLOAD_MD" ] || die \
        "nothing is mounted at ${DATA_MOUNT}. deploy.json must request a RAID1 partition with mountPoint ${DATA_MOUNT} (size 0 = the rest of the disk)."
    PAYLOAD_MD=$(readlink -f "$PAYLOAD_MD")
    case "$(lsblk -dno TYPE "$PAYLOAD_MD")" in
        raid1) ;;
        *) die "${PAYLOAD_MD} (${DATA_MOUNT}) is not a raid1 md array; refusing" ;;
    esac

    # The partition the running system is on must not be the payload.
    local root_src
    root_src=$(readlink -f "$(findmnt -no SOURCE /)")
    [ "$root_src" != "$PAYLOAD_MD" ] || die "/ is on the payload array ${PAYLOAD_MD}; the layout is wrong"

    # Members: exactly one partition per disk, on two different disks, equal size.
    mapfile -t MEMBERS < <(lsblk -nro NAME,TYPE -s "$PAYLOAD_MD" | awk '$2 == "part" {print "/dev/"$1}' | sort)
    log "payload array: ${PAYLOAD_MD} with members: ${MEMBERS[*]:-none}"
    [ "${#MEMBERS[@]}" -eq 2 ] \
        || die "expected exactly 2 members in ${PAYLOAD_MD}, found ${#MEMBERS[@]}"

    DISKS=()
    local m disk
    for m in "${MEMBERS[@]}"; do
        disk=$(lsblk -no PKNAME "$m" | head -1)
        [ -n "$disk" ] || die "cannot determine the parent disk of ${m}"
        DISKS+=("/dev/$disk")
    done
    [ "${DISKS[0]}" != "${DISKS[1]}" ] \
        || die "both members of ${PAYLOAD_MD} are on ${DISKS[0]}; that is not a mirror"

    local s0 s1
    s0=$(blockdev --getsize64 "${MEMBERS[0]}")
    s1=$(blockdev --getsize64 "${MEMBERS[1]}")
    log "member sizes: ${MEMBERS[0]}=${s0} ${MEMBERS[1]}=${s1}"
    [ "$s0" -eq "$s1" ] || die "members differ in size; RAID1 needs matching members"

    # Nothing but the payload array may hold these partitions. If anything else does,
    # destroying them would take it down too.
    local holder holders
    for m in "${MEMBERS[@]}"; do
        holders=$(ls "/sys/class/block/$(basename "$m")/holders" 2>/dev/null || true)
        for holder in $holders; do
            [ "/dev/$holder" = "$PAYLOAD_MD" ] \
                || die "${m} is also held by /dev/${holder}; refusing to destroy it"
        done
        if findmnt -rn -S "$m" >/dev/null 2>&1; then
            die "${m} is mounted directly; refusing"
        fi
    done

    log "layout OK: payload is ${PAYLOAD_MD} over ${MEMBERS[*]}; bootstrap root is ${root_src}"
}

config_drive_devices() {
    blkid -o device -t LABEL=cidata 2>/dev/null
    blkid -o device -t LABEL=config-2 2>/dev/null
}

wait_for_config_drive() {
    # Wait for the config drive to appear, with a timeout, instead of ordering this unit
    # after cloud-init and hoping it finishes.
    #
    # cloud-init does NOT mount the config drive for us -- read_passphrase() mounts it
    # itself by label -- but the kernel does have to enumerate the partition first. On
    # OVHcloud that has happened by the time multi-user.target is reached, so this
    # normally returns immediately; the loop is here so that a slow disk costs a retry
    # rather than an install.
    #
    # This exists because of what it replaces: the unit carried After=cloud-init.target,
    # cloud-init stalled, its target was never reached, and the installer consequently
    # never ran at all. A timeout that reports what it was waiting for is a much better
    # failure mode than a job that waits forever and says nothing.
    local waited=0
    while [ "$waited" -lt "$CONFIG_DRIVE_TIMEOUT_SEC" ]; do
        [ -n "$(config_drive_devices)" ] && return 0
        sleep 2
        waited=$((waited + 2))
    done
    warn "no config-drive partition (LABEL=cidata or config-2) after ${CONFIG_DRIVE_TIMEOUT_SEC}s"
    warn "continuing anyway — read_passphrase will report what it finds"
    return 0
}

# Where the user-data lives on a mounted config drive. Two layouts exist and OVHcloud
# uses the second:
#
#   NoCloud          LABEL=cidata     /user-data                    (vfat, what the
#                                                                     README's wording
#                                                                     suggested)
#   OpenStack v2     LABEL=config-2   /openstack/latest/user_data   (iso9660, what the
#                                                                     deployer actually
#                                                                     writes)
#
# The first deployment with the payload layout died here: the drive was found, mounted,
# and had no /user-data, because it is an OpenStack config drive -- blkid shows it as
# TYPE="iso9660" LABEL="config-2" -- and its user data is at openstack/latest/user_data.
# The error said "no cmesh_luks_passphrase found", which was true and useless. Every
# layout cloud-init itself would read is tried, and the caller lists the drive when none
# matches, so the next variant names itself.
#
# CMESH-CONFIG-DRIVE-PATH-BEGIN (test/config-drive-test.sh extracts this function)
config_drive_user_data() { # config_drive_user_data <mountpoint> -> path on stdout, or 1
    local mnt="$1" p
    for p in "$mnt/user-data" "$mnt/openstack/latest/user_data" "$mnt/ec2/latest/user-data"; do
        [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    done
    # No "latest": take the newest dated API version present.
    p=$(ls -d "$mnt"/openstack/*/user_data 2>/dev/null | sort -r | head -1)
    [ -n "$p" ] && [ -f "$p" ] && { printf '%s\n' "$p"; return 0; }
    return 1
}
# CMESH-CONFIG-DRIVE-PATH-END

read_passphrase() {
    # Supplied via cloud-init configDriveUserData, e.g.:
    #   cmesh_luks_passphrase: "correct horse battery staple"
    #   ssh_authorized_keys:
    #     - ssh-ed25519 AAAA... you@host
    #
    # The config drive is a small partition labelled 'cidata' or 'config-2' (on OVHcloud:
    # iso9660, OpenStack layout -- see config_drive_user_data). It is read here — before
    # anything is destroyed — and scrubbed later.
    #
    # The SSH keys are read in the same pass, from the same file, and for the same
    # reason: this is the last moment the config drive exists. Relying on cloud-init to
    # have delivered them to the rootfs already would make login depend on cloud-init's
    # stage ordering relative to this unit, which is not something to hang remote access
    # on. Reading them here is deterministic.
    wait_for_config_drive

    local cd_mnt=/run/cmesh-configdrive dev
    mkdir -p "$cd_mnt"

    # Both are assigned inside the loop below, which may never reach an assignment if no
    # config-drive partition mounts. Under `set -u` that would abort on first use, so
    # initialise them here.
    LUKS_PASSPHRASE=""
    CMESH_SSH_KEYS=""
    CMESH_ADMIN_USER=""

    local ud seen=""
    for dev in $(config_drive_devices); do
        if mount -o ro "$dev" "$cd_mnt" 2>/dev/null; then
            seen="${seen}${dev}: $(blkid -o value -s TYPE "$dev" 2>/dev/null) $(find "$cd_mnt" -maxdepth 3 -type f 2>/dev/null | sed "s|^$cd_mnt||" | tr '\n' ' ')"$'\n'
            if ud=$(config_drive_user_data "$cd_mnt"); then
                log "config drive ${dev}: user data at ${ud#"$cd_mnt"}"
                # Take the last match: later keys win, and it tolerates a commented
                # example line above the real one.
                LUKS_PASSPHRASE=$(grep -E '^[[:space:]]*cmesh_luks_passphrase:' "$ud" \
                    | tail -1 | sed -E 's/^[^:]*:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//')

                # ssh_authorized_keys is a YAML list, so the keys are the indented "- "
                # lines that FOLLOW the key. Collecting every such line would also match
                # other list keys in the cloud-config, so this tracks the section and
                # stops at the first line that dedents back out of it.
                # CMESH-SSH-KEY-PARSER-BEGIN (test/ssh-key-test.sh extracts this block)
                CMESH_SSH_KEYS=$(awk '
                    /^[[:space:]]*ssh_authorized_keys:/ { inseck=1; next }
                    inseck {
                        if ($0 ~ /^[[:space:]]*-[[:space:]]/) {
                            line = $0
                            sub(/^[[:space:]]*-[[:space:]]*/, "", line)
                            sub(/[[:space:]]+$/, "", line)
                            gsub(/^["'"'"']|["'"'"']$/, "", line)
                            if (length(line) > 0) print line
                            next
                        }
                        inseck = 0
                    }
                ' "$ud")
                # CMESH-SSH-KEY-PARSER-END
                # Optional: the name of the key-only admin account the installed system
                # gets (default "admin"). Root's SSH login is disabled once it exists.
                CMESH_ADMIN_USER=$(grep -E '^[[:space:]]*cmesh_admin_user:' "$ud" \
                    | tail -1 | sed -E 's/^[^:]*:[[:space:]]*//; s/^["'"'"']//; s/["'"'"']$//')
            else
                warn "config drive ${dev} has no user data in any known layout"
            fi
            umount "$cd_mnt"
            [ -n "${LUKS_PASSPHRASE:-}" ] && break
        else
            warn "config drive ${dev} could not be mounted"
        fi
    done

    if [ -z "$LUKS_PASSPHRASE" ]; then
        warn "config drives seen (device: fstype files):"
        printf '%s' "$seen" | sed 's/^/    /' >&2
        die "no cmesh_luks_passphrase found on the config drive. Set it in configDriveUserData (base64-encoded cloud-config)."
    fi

    [ "${#LUKS_PASSPHRASE}" -ge 12 ] || die \
        "cmesh_luks_passphrase is too short (${#LUKS_PASSPHRASE} chars); use at least 12"

    log "passphrase read from the config drive (${#LUKS_PASSPHRASE} chars)"

    CMESH_ADMIN_USER="${CMESH_ADMIN_USER:-admin}"
    printf '%s' "$CMESH_ADMIN_USER" | grep -Eq '^[a-z_][a-z0-9_-]{0,31}$' \
        || die "cmesh_admin_user '${CMESH_ADMIN_USER}' is not a valid account name"
    [ "$CMESH_ADMIN_USER" != root ] || die "cmesh_admin_user must not be root"

    if [ -n "$CMESH_SSH_KEYS" ]; then
        log "SSH keys read from the config drive: $(printf '%s\n' "$CMESH_SSH_KEYS" | grep -c . )"
    else
        warn "no ssh_authorized_keys in the config drive user-data."
        warn "  The installed system will boot with sshd running but NO key, so the"
        warn "  only way in is the OVHcloud KVM console. Add to configDriveUserData:"
        warn "    ssh_authorized_keys:"
        warn "      - ssh-ed25519 AAAA... you@host"
    fi
}

### Release and encrypt the payload #################################################

release_payload() {
    # Hand the payload partitions back: unmount, forget the mount, stop the array, and
    # erase every signature so nothing re-assembles or re-mounts the old array.
    log "releasing ${PAYLOAD_MD} (${DATA_MOUNT}) — DESTRUCTIVE from here"

    umount "$DATA_MOUNT" \
        || die "could not unmount ${DATA_MOUNT}; something is using it"

    # The bootstrap's fstab lists the payload mount. The array is about to stop existing,
    # and this fstab stays on the dormant bootstrap root: if that system is ever booted
    # again, a missing non-nofail mount would hang it in emergency mode.
    if [ -f /etc/fstab ]; then
        awk -v m="$DATA_MOUNT" '$2 != m' /etc/fstab > /run/cmesh-byol.fstab
        cat /run/cmesh-byol.fstab > /etc/fstab
        rm -f /run/cmesh-byol.fstab
        systemctl daemon-reload || true
    fi

    mdadm --stop "$PAYLOAD_MD"
    udevadm settle

    local m
    for m in "${MEMBERS[@]}"; do
        # The md superblock sits 4 KiB into the partition. Leaving it would make udev's
        # incremental assembly rule pick the partition up as a RAID member again.
        mdadm --zero-superblock "$m"
        wipefs -a "$m"
    done
    udevadm settle

    # Prove they are free before formatting them.
    for m in "${MEMBERS[@]}"; do
        [ -z "$(ls "/sys/class/block/$(basename "$m")/holders" 2>/dev/null)" ] \
            || die "${m} still has a holder after the array was stopped"
    done
    [ ! -e "$PAYLOAD_MD" ] || die "${PAYLOAD_MD} still exists after mdadm --stop"

    # The partition type GUID stays whatever the deployer set (Linux RAID). It is not
    # changed on purpose: rewriting the GPT of a live disk is exactly the operation this
    # design exists to avoid, and the kernel does not consult the type for anything.
    log "payload partitions released: ${MEMBERS[*]}"
}

create_encrypted_root() {
    log "creating LUKS2 containers (one header per disk)"

    local keyfile=$1
    local i=0 m
    for m in "${MEMBERS[@]}"; do
        # aes-xts-plain64 with a 512-bit key is AES-256-XTS. argon2id is the LUKS2
        # default and is correct — do not tune it down.
        cryptsetup luksFormat --type luks2 \
            --cipher aes-xts-plain64 --key-size 512 \
            --hash sha256 --pbkdf argon2id \
            --batch-mode "$m" "$keyfile"

        # The operator passphrase is a SECOND keyslot, so it survives as the rescue path
        # after the temporary keyfile is deleted at finalize. No trailing newline: what
        # is typed at a passphrase prompt later has to match byte for byte.
        cryptsetup luksAddKey --key-file "$keyfile" --batch-mode \
            "$m" <(printf '%s' "$LUKS_PASSPHRASE")

        cryptsetup open "$m" "cryptroot${i}" --key-file "$keyfile"
        udevadm settle
        i=$((i + 1))
    done

    log "creating ${ROOT_MD} (/, raid1 over the dm-crypt mappings)"
    # The members are dm-crypt devices, NOT the raw partitions — this is the whole point.
    mdadm --create "$ROOT_MD" --level=1 --raid-devices=2 --metadata=1.2 \
        --name="$ROOT_MD_NAME" --run /dev/mapper/cryptroot0 /dev/mapper/cryptroot1
    udevadm settle
    [ -e "$ROOT_MD" ] || die "${ROOT_MD} did not appear after mdadm --create"

    # -m 1: ext4 reserves 5% of the volume for root by default. That default is tuned for
    # a small root partition where a full disk would break the system; on a ~890 GiB data
    # volume it silently withholds ~44 GiB from every non-root user, including postgres.
    # 1% (~9 GiB) keeps the fragmentation headroom the reservation exists for.
    mkfs.ext4 -q -L "$ROOT_MD_NAME" -m 1 "$ROOT_MD"
    udevadm settle
}

### Install into the encrypted root #################################################

mount_target() {
    log "mounting the encrypted root at ${MNT}"
    mkdir -p "$MNT"
    mount "$ROOT_MD" "$MNT"
    mkdir -p "$MNT/boot"
    # /boot (and the ESP under it) are SHARED with the bootstrap, so they are bound in,
    # not re-created: the kernel, the microcode images and GRUB are already there. The
    # rslave stops unmounts under $MNT from propagating back to the real /boot.
    mount --rbind /boot "$MNT/boot"
    mount --make-rslave "$MNT/boot"
    [ -f "$MNT/boot/vmlinuz-linux" ] \
        || die "no kernel at ${MNT}/boot/vmlinuz-linux — /boot is not what this expects"
}

copy_rootfs() {
    # Copy the running system straight into the target. No staging: the bootstrap root
    # stays mounted and intact throughout, so there is nothing to protect it from.
    #
    # -x keeps rsync on the root filesystem, so /boot, /proc, /sys, /dev, /run, /tmp and
    # the target itself are skipped by construction; the explicit excludes are for things
    # that live ON the root filesystem and must not carry across.
    log "copying the rootfs into the encrypted root"
    rsync -aAXH --numeric-ids -x \
        --exclude="${MNT}" \
        --exclude="${DATA_MOUNT}" \
        --exclude=/var/lib/cmesh-byol \
        --exclude="${LOG}" \
        --exclude=/swap \
        --exclude=/lost+found \
        --info=stats1 \
        / "$MNT/"
    log "rootfs copied"
}

create_swap() {
    # Swap lives in a FILE inside the encrypted root, not in its own partition.
    #
    # WHY NOT A SWAP PARTITION: swap holds whatever was in RAM when the kernel decided
    # to evict it. On this host that means customer records, chat transcripts, database
    # pages and — because the LUKS mappings are open — potentially key material. An
    # unencrypted swap partition would quietly undo the encryption-at-rest property the
    # rest of the disk layout exists to provide. A plain swap FILE on the encrypted root
    # inherits that encryption with no extra machinery.
    #
    # The alternative that is also correct is a dedicated LUKS swap partition keyed with
    # a random key per boot (`crypttab` option `swap`). That is more moving parts for no
    # additional protection here, since the root is already encrypted by the same key.
    #
    # WHY SWAP AT ALL: without it, memory pressure on a database server invokes the OOM
    # killer and terminates postgres. With it, cold anonymous pages are evicted and the
    # process survives. Absence of swap is a deliberate choice only for a host whose
    # memory is provably oversized for its workload.
    log "creating the swap file on the encrypted root"

    # Size to a fraction of RAM: enough headroom for pressure, capped so it does not
    # consume the disk on a very large-memory machine.
    local mem_mib swap_mib
    mem_mib=$(awk '/^MemTotal:/ {printf "%d", $2/1024}' /proc/meminfo)
    if [ "$mem_mib" -le 8192 ]; then
        swap_mib=4096
    else
        swap_mib=$((mem_mib / 2))
        [ "$swap_mib" -gt 8192 ] && swap_mib=8192
    fi

    # fallocate is instant; on ext4 it produces a file with no extents to zero.
    mkdir -p "$MNT/swap"
    if ! fallocate -l "${swap_mib}MiB" "$MNT/swap/swapfile" 2>/dev/null; then
        # Fallback for filesystems where fallocate cannot make a swap file.
        dd if=/dev/zero of="$MNT/swap/swapfile" bs=1M count="$swap_mib" status=none
    fi

    # 0600 is required: a world-readable swap file exposes another user's pages.
    chmod 0600 "$MNT/swap/swapfile"
    chattr +C "$MNT/swap/swapfile" 2>/dev/null || true
    chown root:root "$MNT/swap/swapfile"

    mkswap -L cmesh-swap "$MNT/swap/swapfile" >/dev/null

    # pri=0 so the kernel does not consider this device a hibernation/resume candidate.
    # Hibernation is refused deliberately — see the README. A resume image is a full
    # decrypted copy of RAM, and on a PHI host that is a risk with no operational
    # justification when suspend-to-idle is available.
    #
    # Appended, so this MUST run after write_system_config has written the fstab.
    printf '/swap/swapfile  none  swap  defaults,pri=0  0 0\n' >> "$MNT/etc/fstab"
    log "swap: ${swap_mib} MiB at /swap/swapfile (encrypted by the root volume)"
}

write_system_config() {
    log "writing fstab, mdadm.conf, crypttab and mkinitcpio configuration"

    # Everything is referenced by UUID, never by /dev/mdN. md array NUMBERS are not
    # stable: an array assembled without a matching /etc/mdadm.conf entry can come up
    # as md126 or md127. The UUID is a property of the filesystem and does not move.
    #
    # /boot and the ESP are the deployer's: read their UUIDs from what is mounted.
    local boot_uuid esp_uuid
    ROOT_UUID=$(blkid -s UUID -o value "$ROOT_MD")
    boot_uuid=$(findmnt -no UUID /boot)
    esp_uuid=$(findmnt -no UUID /boot/efi)

    [ -n "$ROOT_UUID" ] || die "could not read the UUID of ${ROOT_MD}"
    [ -n "$boot_uuid" ] || die "could not read the UUID of the /boot filesystem"
    [ -n "$esp_uuid" ]  || die "could not read the UUID of the ESP at /boot/efi"

    cat > "$MNT/etc/fstab" <<EOF
# Generated by cmesh-byol-install. LUKS under RAID1. UUIDs only: md numbers are not stable.
UUID=${ROOT_UUID}  /          ext4  defaults                      0 1
UUID=${boot_uuid}  /boot      ext4  defaults,nofail              0 2
UUID=${esp_uuid}   /boot/efi  vfat  defaults,nofail,umask=0077  0 2
EOF

    # /etc/mdadm.conf on the TARGET. `--scan` lists the arrays that are RUNNING now: the
    # deployer's /boot and bootstrap-root arrays, and the new encrypted root. The payload
    # array was stopped before this point, so it is correctly absent — every line here
    # describes an array that will exist on the installed system.
    log "writing the target /etc/mdadm.conf"
    if mdadm --detail --scan > "$MNT/etc/mdadm.conf" 2>/dev/null && [ -s "$MNT/etc/mdadm.conf" ]; then
        printf 'HOMEHOST <system>\n' >> "$MNT/etc/mdadm.conf"
        grep -q "$ROOT_MD_NAME" "$MNT/etc/mdadm.conf" \
            || die "the new root array is missing from mdadm --detail --scan"
        log "  $(grep -c '^ARRAY' "$MNT/etc/mdadm.conf") array(s) recorded for the installed system"
        sed 's/^/    /' "$MNT/etc/mdadm.conf"
    else
        die "could not generate the target mdadm.conf"
    fi

    # crypttab for the INITRAMFS: the root array cannot assemble until both mappings
    # exist, so these must be unlocked before mdadm runs. Keyed by UUID (device names
    # are not stable); unlocked during install by the temporary keyfile on /boot, which
    # cmesh-byol-finalize deletes once the TPM is enrolled.
    cat > "$MNT/etc/crypttab.initramfs" <<EOF
# Generated by cmesh-byol-install.
cryptroot0  UUID=$(cryptsetup luksUUID "${MEMBERS[0]}")  ${LUKS_KEY}  luks,discard,tpm2-device=auto
cryptroot1  UUID=$(cryptsetup luksUUID "${MEMBERS[1]}")  ${LUKS_KEY}  luks,discard,tpm2-device=auto
EOF

    # The installed system's initramfs is NOT the bootstrap's. systemd + sd-encrypt is
    # correct here (it understands the crypttab above and a TPM2 keyslot without
    # prompting); mdadm_udev assembles the arrays after the mappings appear. nvme and
    # raid1 are named explicitly rather than left to autodetect: one missed module is an
    # unbootable machine with no output.
    cat > "$MNT/etc/mkinitcpio.conf" <<'EOF'
# Generated by cmesh-byol-install.
MODULES=(nvme raid1)
BINARIES=()
FILES=(/boot/cmesh-luks.key)
HOOKS=(base systemd autodetect microcode modconf kms keyboard sd-vconsole block mdadm_udev sd-encrypt filesystems fsck)
EOF

    # Carry cloud-init state nowhere: the installed system is not reconfigured by the
    # config drive, and cloud-init has already served its purpose.
    rm -f "$MNT/etc/machine-id"
}

with_chroot_mounts() {
    # Run a command with /dev, /proc and /sys bound into the target, then unbind them.
    local fs
    for fs in dev proc sys; do
        mount --rbind "/$fs" "$MNT/$fs"
        mount --make-rslave "$MNT/$fs"
    done
    local rc=0
    "$@" || rc=$?
    for fs in dev proc sys; do
        umount -R "$MNT/$fs" 2>/dev/null || true
    done
    return "$rc"
}

generate_initramfs() {
    # POINT OF NO RETURN FOR THE BOOTSTRAP. /boot is shared, so this overwrites the
    # bootstrap's initramfs with the target's. From here the machine boots the encrypted
    # system or nothing; everything that can be verified beforehand has been.
    log "generating the initramfs inside the target (overwrites the shared /boot image)"
    with_chroot_mounts chroot "$MNT" mkinitcpio -P

    local img="$MNT/boot/initramfs-linux.img"
    [ -f "$img" ] || die "no initramfs was produced at ${img}"
    # The image must carry the crypttab and the keyfile, or the first boot stops at a
    # passphrase prompt that nobody is there to answer.
    lsinitcpio "$img" | grep -q 'etc/crypttab' \
        || die "the initramfs does not contain etc/crypttab; sd-encrypt would have nothing to unlock"
    lsinitcpio "$img" | grep -q 'cmesh-luks.key' \
        || die "the initramfs does not contain the temporary keyfile; the first boot would prompt"
    log "initramfs verified: crypttab and keyfile present"
}

update_bootloader() {
    # GRUB itself is NOT reinstalled. The deploy hook put it on the ESP(s) and it already
    # boots this /boot; only grub.cfg has to change, to point root= at the new filesystem.
    log "regenerating grub.cfg for the encrypted root"
    with_chroot_mounts chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg

    local cfg="$MNT/boot/grub/grub.cfg"
    [ -f "$cfg" ] || die "grub-mkconfig produced no ${cfg}"

    if ! grep -q "root=UUID=${ROOT_UUID}" "$cfg"; then
        # grub-probe could not resolve the root filesystem's UUID through dm-crypt, so
        # 10_linux fell back to a device path, which is not stable. Pin it ourselves.
        warn "grub.cfg does not carry root=UUID=${ROOT_UUID}; pinning it via GRUB_CMDLINE_LINUX"
        sed -i -E "s|^GRUB_CMDLINE_LINUX=\"([^\"]*)\"|GRUB_CMDLINE_LINUX=\"\1 root=UUID=${ROOT_UUID}\"|" \
            "$MNT/etc/default/grub"
        grep -q "root=UUID=${ROOT_UUID}" "$MNT/etc/default/grub" \
            || die "could not add root=UUID to ${MNT}/etc/default/grub"
        with_chroot_mounts chroot "$MNT" grub-mkconfig -o /boot/grub/grub.cfg
        grep -q "root=UUID=${ROOT_UUID}" "$cfg" \
            || die "grub.cfg still does not reference the encrypted root"
    fi

    # The loader the firmware falls back to, on the ESP the deployer mounted. Without an
    # NVRAM entry (OVHcloud servers network-boot; the hook uses --no-nvram) this file is
    # the only boot path.
    [ -f /boot/efi/EFI/BOOT/BOOTX64.EFI ] \
        || die "/boot/efi/EFI/BOOT/BOOTX64.EFI is missing; the deploy hook did not install a loader"

    # The other disk's ESP should carry a mirror of it (the hook copies it). A missing
    # mirror costs redundancy, not the boot, so it is a warning.
    local esp tmp
    for esp in $(blkid -o device -t PARTTYPE=c12a7328-f81f-11d2-ba4b-00a0c93ec93b 2>/dev/null); do
        findmnt -rn -S "$esp" >/dev/null 2>&1 && continue
        tmp=$(mktemp -d)
        if mount -o ro "$esp" "$tmp" 2>/dev/null; then
            [ -f "$tmp/EFI/BOOT/BOOTX64.EFI" ] \
                || warn "${esp}: no /EFI/BOOT/BOOTX64.EFI; this disk cannot boot on its own"
            umount "$tmp"
        else
            warn "could not mount ${esp} to check for a mirrored loader"
        fi
        rmdir "$tmp"
    done

    log "grub.cfg points at UUID=${ROOT_UUID}; loader present on the ESP"
}

scrub_config_drive() {
    # The passphrase was on the config drive in cleartext. Overwrite it so the only
    # remaining copy is inside the LUKS keyslots.
    log "scrubbing the config drive"
    # The whole device, sized from the device: OVHcloud's drive is 2 MiB, and a fixed
    # 8 MiB write runs off the end, which dd reports as a failure after it has in fact
    # overwritten everything.
    local dev size
    for dev in $(config_drive_devices); do
        size=$(blockdev --getsize64 "$dev" 2>/dev/null || echo 0)
        if [ "$size" -gt 0 ] \
            && dd if=/dev/urandom of="$dev" bs=4096 count=$((size / 4096)) conv=fsync status=none 2>/dev/null; then
            log "scrubbed ${dev} (${size} bytes)"
        else
            warn "could not scrub ${dev} — the passphrase may remain on it"
        fi
    done
}

install_admin_user() {
    # A named, key-only, sudo-capable account; then root is closed to SSH.
    #
    # HIPAA wants every action attributable to a person (unique user identification,
    # 164.312(a)(2)(i)); a shared root login is the opposite of that. The account is
    # created in the target, gets the SAME keys as root (so the operator's existing key
    # works unchanged), and is in wheel, which the hardening's sudoers drop-in grants
    # NOPASSWD sudo -- there is no password to ask for. Only once the keys are in place
    # is the sshd drop-in written that turns root login off: a failure anywhere above
    # leaves root reachable rather than nobody.
    #
    # The same drop-in is written by cmesh-byol-harden on a live server; this is the
    # install-time path so a fresh deployment never has root open over SSH at all.
    local u="$CMESH_ADMIN_USER" home
    if ! chroot "$MNT" getent passwd "$u" >/dev/null 2>&1; then
        chroot "$MNT" useradd -m -G wheel -s /bin/bash "$u" \
            || { warn "could not create admin user ${u}; root SSH login stays enabled"; return 0; }
        log "created admin user ${u} (wheel, no password)"
    else
        chroot "$MNT" usermod -aG wheel "$u" || true
    fi
    home=$(chroot "$MNT" getent passwd "$u" | cut -d: -f6)
    [ -n "$home" ] || { warn "no home for ${u}; root SSH login stays enabled"; return 0; }
    install -d -m 0700 "$MNT$home/.ssh"
    printf '%s\n' "$CMESH_SSH_KEYS" > "$MNT$home/.ssh/authorized_keys"
    chmod 0600 "$MNT$home/.ssh/authorized_keys"
    chroot "$MNT" chown -R "$u:$u" "$home/.ssh"
    [ -s "$MNT$home/.ssh/authorized_keys" ] \
        || { warn "${u} has no keys; root SSH login stays enabled"; return 0; }
    # CMESH-ROOT-LOGIN-OFF
    install -Dm644 /dev/stdin "$MNT/etc/ssh/sshd_config.d/20-cmesh-users.conf" <<EOF
# Written by cmesh-byol-install: ${u} has $(grep -c . "$MNT$home/.ssh/authorized_keys") key(s) and is in wheel.
PermitRootLogin no
AllowUsers ${u}
EOF
    log "root SSH login disabled on the installed system; log in as ${u} and use sudo"
}

install_ssh_keys() {
    # Write the keys read from the config drive, and enable sshd.
    #
    # WHY BOTH, AND WHY HERE
    #
    # The first install booted successfully and was then unreachable: the installer
    # enabled systemd-networkd and systemd-resolved but never enabled sshd, and the
    # image's sshd is not enabled by default. Everything below is the fix.
    #
    # The keys come from the config drive rather than from whatever cloud-init left in
    # the rootfs, because this is deterministic: it does not depend on whether cloud-init
    # ran before the config drive was scrubbed, or on which of its stages delivered the
    # keys. The rootfs is copied from the running bootstrap system, so anything
    # cloud-init did write does carry over — but "carries over" is not something to bet
    # remote access on.
    if [ -n "$CMESH_SSH_KEYS" ]; then
        log "installing SSH keys for root"
        install -d -m 0700 "$MNT/root/.ssh"
        printf '%s\n' "$CMESH_SSH_KEYS" > "$MNT/root/.ssh/authorized_keys"
        chmod 0600 "$MNT/root/.ssh/authorized_keys"
        log "authorized_keys: $(grep -c . "$MNT/root/.ssh/authorized_keys") key(s)"
        install_admin_user
    else
        warn "no SSH keys to install; log in over the OVHcloud KVM console instead"
    fi

    # Enable whichever unit this image actually ships. Arch calls it sshd.service; the
    # alias ssh.service exists on some builds. Test for the unit file rather than
    # creating a symlink unconditionally, so a missing or renamed unit is reported here
    # instead of showing up later as a broken symlink in multi-user.target.wants.
    local unit
    for unit in sshd.service ssh.service; do
        if [ -f "$MNT/usr/lib/systemd/system/$unit" ] \
            || [ -f "$MNT/etc/systemd/system/$unit" ]; then
            chroot "$MNT" systemctl enable "$unit" 2>/dev/null \
                || ln -sf "/usr/lib/systemd/system/$unit" \
                    "$MNT/etc/systemd/system/multi-user.target.wants/$unit"
            log "enabled $unit"
            return 0
        fi
    done

    # Not fatal: the install itself succeeded and the disk is correct, so failing here
    # would leave a working encrypted system behind a non-zero exit. Say it loudly.
    warn "sshd is NOT installed in this image — the machine will have no remote access."
    warn "  reach it over the OVHcloud KVM console, then: pacman -S openssh && systemctl enable --now sshd"
}

configure_target_system() {
    log "configuring the installed system"

    # Networking. cloud-init configures the BOOTSTRAP image, not the installed system,
    # so without this the machine comes up encrypted and unreachable.
    install -Dm644 /dev/stdin "$MNT/etc/systemd/network/20-wired.network" <<'EOF'
# Generated by cmesh-byol-install.
[Match]
Name=en* eth*

[Network]
DHCP=yes
EOF
    ln -sf /run/systemd/resolve/stub-resolv.conf "$MNT/etc/resolv.conf"

    # Enable the finalize unit; it is what removes the temporary key.
    ln -sf /etc/systemd/system/cmesh-byol-finalize.service \
        "$MNT/etc/systemd/system/multi-user.target.wants/cmesh-byol-finalize.service"

    # This installer must NOT run again on the installed system: disable its unit there
    # and write the marker the finalize unit's ConditionPathExists looks for. Without
    # both, the installed system would try to install itself a second time and finalize
    # would never run.
    rm -f "$MNT/etc/systemd/system/multi-user.target.wants/cmesh-byol-install.service"
    install -d -m 0755 "$MNT$(dirname "$MARKER")"
    date -Is > "$MNT$MARKER"

    chroot "$MNT" systemd-machine-id-setup
    chroot "$MNT" systemctl enable systemd-networkd systemd-resolved 2>/dev/null || true

    install_ssh_keys

    # cloud-init served the BOOTSTRAP boot only: it is what made the config drive
    # readable, and that drive is about to be scrubbed. Leaving it enabled on the
    # installed system means a service that waits for a datasource that is never coming
    # — and cloud-init has network-configuration modules of its own, which would race
    # systemd-networkd for the interface. Networking above is ours; cloud-init is done.
    local unit
    for unit in cloud-init.service cloud-init-local.service cloud-config.service \
                cloud-final.service cloud-init.target; do
        chroot "$MNT" systemctl disable "$unit" 2>/dev/null || true
    done
    log "disabled cloud-init on the installed system (networking is systemd-networkd)"
}

### Main ############################################################################

main() {
    log "cmesh-byol-install starting"

    check_already_done
    check_arch
    check_tools
    check_layout
    read_passphrase

    # Everything above is non-destructive and re-runnable. From here the payload goes.
    release_payload

    mkdir -p "$WORKDIR"
    local keyfile="$WORKDIR/luks.key"
    # 64 random bytes, and it goes into a SECOND keyslot so the operator passphrase
    # remains valid after this file is deleted.
    dd if=/dev/urandom of="$keyfile" bs=64 count=1 status=none
    chmod 0400 "$keyfile"

    create_encrypted_root "$keyfile"

    mount_target
    copy_rootfs
    write_system_config
    # After write_system_config: the swap entry is appended to the fstab it writes.
    create_swap
    configure_target_system

    # The temporary unlock key lives on the (unencrypted, shared) /boot so the machine
    # can reboot unattended. cmesh-byol-finalize removes it once the TPM is enrolled.
    cp "$keyfile" "$MNT${LUKS_KEY}"
    chmod 0400 "$MNT${LUKS_KEY}"
    rm -f "$keyfile"

    # Last, because these two rewrite the shared /boot: once they run, the next boot is
    # the encrypted system.
    generate_initramfs
    update_bootloader

    sync
    umount -R "$MNT" 2>/dev/null || true

    scrub_config_drive

    # Marker on the bootstrap root last: until this exists, a failure leaves the system
    # re-runnable (the target marker was written inside configure_target_system).
    mkdir -p "$(dirname "$MARKER")"
    date -Is > "$MARKER"
    systemctl disable cmesh-byol-install.service || true

    echo
    log "INSTALL COMPLETE — rebooting into the encrypted system"
    echo "    After it comes back, verify with the README's 'Verifying an installation'."
    echo "    The temporary unlock key at ${LUKS_KEY} is removed by"
    echo "    cmesh-byol-finalize once the TPM is enrolled."
    echo
    sync
    sleep 2
    systemctl reboot
}

main "$@"
