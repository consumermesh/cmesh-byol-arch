# OVHcloud API credentials for scripts/ovh-reinstall.exs.
#
# Copy to deploy.env and fill in. deploy.env is gitignored; this file is not, so do not
# put real credentials here.
#
# Create the token at https://api.ovh.com/createToken/ with these rights:
#
#   GET  /dedicated/server/*
#   POST /dedicated/server/*/reinstall
#
# The application secret is shown ONCE when the token is created. If it is lost, create a
# new token -- there is no way to recover it.

OVH_APPLICATION_KEY=
OVH_APPLICATION_SECRET=
OVH_CONSUMER_KEY=

# ovh-eu | ovh-ca | ovh-us
OVH_ENDPOINT=ovh-eu

# The server's internal name, exactly as the API uses it.
OVH_SERVICE_NAME=ns5004419.ip-51-222-11.net
